# ============================================================
# SecureCloud Backend Environment Configuration
# ============================================================
# Copy this file to .env and replace placeholder values.
# NEVER commit the actual .env file or leak secrets.

# Application Environment & Server Port
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Connection String (Atlas M0 Free Tier or Local MongoDB)
# Example: mongodb+srv://securecloud_user:<password>@cluster0.abcde.mongodb.net/securecloud?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-address>/securecloud?retryWrites=true&w=majority

# Supabase Storage Configuration (Free Project)
# Found under: Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# CRITICAL: Use the secret 'service_role' key, NEVER the public 'anon' key!
# Backend uses this key exclusively; it must never be exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-key
# Private bucket name created in Supabase Dashboard
SUPABASE_STORAGE_BUCKET=securecloud-files

# JWT Secrets (Use strong random strings, min 32 chars. e.g., generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_ACCESS_SECRET=replace-with-a-random-32-byte-hex-string-for-access-token
JWT_REFRESH_SECRET=replace-with-a-random-32-byte-hex-string-for-refresh-token
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY_DAYS=7

# File Limits & Storage Quotas
# 25 MB max per file upload (25 * 1024 * 1024)
MAX_FILE_SIZE_BYTES=26214400
# 100 MB default quota per user (100 * 1024 * 1024)
DEFAULT_USER_QUOTA_BYTES=104857600

# Cookie Security
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
